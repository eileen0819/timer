.container {
  padding: 40rpx 30rpx;
  background-color: #FFFDF7;
  min-height: 100vh;
}

.summary-cards {
  display: flex;
  gap: 30rpx;
  margin-bottom: 40rpx;
}

.summary-card {
  flex: 1;
  background-color: #ffffff;
  border-radius: 40rpx;
  padding: 40rpx 20rpx;
  text-align: center;
  border: 6rpx solid #2D3436;
  box-shadow: 8rpx 8rpx 0px #2D3436;
  transform: rotate(-1deg);
  transition: all 0.2s;
}

.summary-card:nth-child(2) {
  transform: rotate(1deg);
}

.summary-card:active {
  transform: rotate(0deg) translate(6rpx, 6rpx);
  box-shadow: 2rpx 2rpx 0px #2D3436;
}

.card-value {
  display: block;
  font-size: 48rpx;
  font-weight: 900;
  color: #FF6B6B;
  margin-bottom: 12rpx;
  text-shadow: 2rpx 2rpx 0px rgba(0,0,0,0.1);
}

.card-label {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #636E72;
}

.chart-section,
.month-section,
.projects-section {
  background-color: #ffffff;
  border-radius: 40rpx;
  padding: 40rpx 30rpx;
  margin-bottom: 40rpx;
  border: 6rpx solid #2D3436;
  box-shadow: 8rpx 8rpx 0px #2D3436;
}

.project-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 4rpx dashed #2D3436;
}

.project-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.project-info {
  display: flex;
  align-items: center;
}

.project-color {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  border: 4rpx solid #2D3436;
  margin-right: 20rpx;
}

.project-name {
  font-size: 34rpx;
  font-weight: 900;
  color: #2D3436;
}

.project-time {
  font-size: 34rpx;
  font-weight: 900;
  color: #4ECDC4;
  text-shadow: 2rpx 2rpx 0px rgba(0,0,0,0.1);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40rpx;
  padding-bottom: 20rpx;
  border-bottom: 6rpx solid #2D3436;
}

.section-title {
  display: block;
  font-size: 38rpx;
  font-weight: 900;
  color: #2D3436;
}

.section-date {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #636E72;
  background-color: #FFE66D;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  border: 4rpx solid #2D3436;
  box-shadow: 4rpx 4rpx 0px #2D3436;
}

.week-chart {
  padding-top: 20rpx;
}

.chart-bars {
  display: flex;
  justify-content: space-around;
  align-items: flex-end;
  height: 280rpx;
  margin-bottom: 20rpx;
  border-bottom: 6rpx solid #2D3436;
  padding-bottom: 10rpx;
}

.chart-bar-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.chart-bar {
  width: 60rpx;
  background-color: #4ECDC4;
  border: 4rpx solid #2D3436;
  border-bottom: none;
  border-radius: 16rpx 16rpx 0 0;
  min-height: 8rpx;
  transition: height 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  box-shadow: inset -6rpx -4rpx 0px rgba(0,0,0,0.1);
}

.bar-value {
  font-size: 24rpx;
  font-weight: 900;
  color: #2D3436;
  margin-top: 10rpx;
  text-align: center;
}

.week-labels {
  display: flex;
  justify-content: space-around;
}

.week-label {
  font-size: 28rpx;
  font-weight: 900;
  color: #636E72;
  flex: 1;
  text-align: center;
}

.month-grid {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 30rpx;
}

.month-day {
  width: 14.28%;
  aspect-ratio: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border-radius: 20rpx;
  transition: all 0.2s;
}

.month-day.active {
  background-color: #FFE66D;
  border: 4rpx solid #2D3436;
  box-shadow: 4rpx 4rpx 0px #2D3436;
  transform: scale(1.1);
  z-index: 2;
}

.day-number {
  font-size: 28rpx;
  font-weight: bold;
  color: #B2BEC3;
}

.month-day.active .day-number {
  color: #2D3436;
  font-weight: 900;
}

.day-indicator {
  width: 12rpx;
  height: 12rpx;
  background-color: #FF6B6B;
  border-radius: 50%;
  border: 2rpx solid #2D3436;
  margin-top: 6rpx;
}

.month-legend {
  display: flex;
  gap: 40rpx;
  justify-content: center;
  padding-top: 20rpx;
  border-top: 4rpx dashed #2D3436;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.legend-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background-color: #FFFDF7;
  border: 4rpx solid #2D3436;
}

.legend-dot.active {
  background-color: #FFE66D;
  box-shadow: 2rpx 2rpx 0px #2D3436;
}

.legend-text {
  font-size: 28rpx;
  font-weight: bold;
  color: #636E72;
}

.tips-section {
  background-color: #A8E6CF;
  border-radius: 40rpx;
  padding: 40rpx;
  border: 6rpx solid #2D3436;
  box-shadow: 8rpx 8rpx 0px #2D3436;
  position: relative;
  overflow: hidden;
}

.tips-title {
  display: block;
  font-size: 34rpx;
  font-weight: 900;
  color: #2D3436;
  margin-bottom: 15rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.tips-title::before {
  content: '💡';
  font-size: 40rpx;
}

.tips-text {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #2D3436;
  line-height: 1.6;
}
